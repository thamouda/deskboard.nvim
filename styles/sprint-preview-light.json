{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#383A42", "margin": 1 },
  "paragraph": {},
  "block_quote": { "indent": 1, "indent_token": "│ ", "color": "#65738A" },
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#245DA8", "bold": true },
  "h1": { "prefix": "  ", "suffix": "  ", "color": "#244D79", "background_color": "#DBE6F8", "bold": true },
  "h2": { "prefix": "▌ ", "color": "#245DA8", "bold": true },
  "h3": { "prefix": "› ", "color": "#7A3E9D", "bold": true },
  "h4": { "prefix": "· ", "color": "#287A8C", "bold": true },
  "h5": { "prefix": "· ", "color": "#287A8C" },
  "h6": { "prefix": "· ", "color": "#65738A" },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true },
  "strong": { "color": "#885A13", "bold": true },
  "hr": { "color": "#9AA8BE", "format": "\n────────────────────────\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#287A8C", "underline": true },
  "link_text": { "color": "#245DA8", "bold": true },
  "image": { "color": "#7A3E9D" },
  "image_text": { "color": "#65738A", "format": "Image: {{.text}}" },
  "code": { "prefix": " ", "suffix": " ", "color": "#885A13", "background_color": "#E6EAF2" },
  "code_block": {
    "color": "#383A42", "background_color": "#EDF1F7", "margin": 1, "indent": 1,
    "chroma": {
      "text": { "color": "#383A42", "background_color": "#EDF1F7" },
      "error": { "color": "#AD3434", "background_color": "#F8DFDF" },
      "comment": { "color": "#68768A", "italic": true },
      "comment_preproc": { "color": "#98601A" },
      "keyword": { "color": "#7A3E9D", "bold": true },
      "keyword_reserved": { "color": "#7A3E9D", "bold": true },
      "keyword_namespace": { "color": "#7A3E9D" },
      "keyword_type": { "color": "#885A13" },
      "operator": { "color": "#245DA8" },
      "punctuation": { "color": "#383A42" },
      "name": { "color": "#383A42" },
      "name_builtin": { "color": "#287A8C" },
      "name_tag": { "color": "#AD3434" },
      "name_attribute": { "color": "#98601A" },
      "name_class": { "color": "#885A13", "bold": true },
      "name_constant": { "color": "#98601A" },
      "name_decorator": { "color": "#7A3E9D" },
      "name_exception": { "color": "#AD3434" },
      "name_function": { "color": "#245DA8" },
      "literal_number": { "color": "#98601A" },
      "literal_string": { "color": "#407A36" },
      "literal_string_escape": { "color": "#287A8C" },
      "generic_deleted": { "color": "#AD3434", "background_color": "#F8DFDF" },
      "generic_inserted": { "color": "#407A36", "background_color": "#E1EEDC" },
      "generic_emph": { "italic": true },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#245DA8", "bold": true },
      "background": { "background_color": "#EDF1F7" }
    }
  },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "bold": true },
  "definition_description": { "block_prefix": "\n  " },
  "html_block": {},
  "html_span": {}
}
