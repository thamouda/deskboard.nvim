{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#BBC2CF", "margin": 1 },
  "paragraph": {},
  "block_quote": { "indent": 1, "indent_token": "│ ", "color": "#98A3B8" },
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#51AFEF", "bold": true },
  "h1": { "prefix": "  ", "suffix": "  ", "color": "#E6EDF7", "background_color": "#303544", "bold": true },
  "h2": { "prefix": "▌ ", "color": "#51AFEF", "bold": true },
  "h3": { "prefix": "› ", "color": "#C678DD", "bold": true },
  "h4": { "prefix": "· ", "color": "#7DCFFF", "bold": true },
  "h5": { "prefix": "· ", "color": "#7DCFFF" },
  "h6": { "prefix": "· ", "color": "#98A3B8" },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true },
  "strong": { "color": "#ECBE7B", "bold": true },
  "hr": { "color": "#58657D", "format": "\n────────────────────────\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#7DCFFF", "underline": true },
  "link_text": { "color": "#51AFEF", "bold": true },
  "image": { "color": "#C678DD" },
  "image_text": { "color": "#98A3B8", "format": "Image: {{.text}}" },
  "code": { "prefix": " ", "suffix": " ", "color": "#ECBE7B", "background_color": "#333843" },
  "code_block": {
    "color": "#BBC2CF", "background_color": "#20242C", "margin": 1, "indent": 1,
    "chroma": {
      "text": { "color": "#BBC2CF", "background_color": "#20242C" },
      "error": { "color": "#FF6C6B", "background_color": "#3F2A30" },
      "comment": { "color": "#8B95A9", "italic": true },
      "comment_preproc": { "color": "#DA8548" },
      "keyword": { "color": "#C678DD", "bold": true },
      "keyword_reserved": { "color": "#C678DD", "bold": true },
      "keyword_namespace": { "color": "#C678DD" },
      "keyword_type": { "color": "#ECBE7B" },
      "operator": { "color": "#51AFEF" },
      "punctuation": { "color": "#BBC2CF" },
      "name": { "color": "#BBC2CF" },
      "name_builtin": { "color": "#46D9FF" },
      "name_tag": { "color": "#FF6C6B" },
      "name_attribute": { "color": "#ECBE7B" },
      "name_class": { "color": "#ECBE7B", "bold": true },
      "name_constant": { "color": "#DA8548" },
      "name_decorator": { "color": "#C678DD" },
      "name_exception": { "color": "#FF6C6B" },
      "name_function": { "color": "#51AFEF" },
      "literal_number": { "color": "#DA8548" },
      "literal_string": { "color": "#98BE65" },
      "literal_string_escape": { "color": "#46D9FF" },
      "generic_deleted": { "color": "#FF6C6B", "background_color": "#3F2A30" },
      "generic_inserted": { "color": "#98BE65", "background_color": "#29382C" },
      "generic_emph": { "italic": true },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#51AFEF", "bold": true },
      "background": { "background_color": "#20242C" }
    }
  },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": { "bold": true },
  "definition_description": { "block_prefix": "\n  " },
  "html_block": {},
  "html_span": {}
}
